{
  "expo": {
    "name": "HomeManagerReactApp",
    "slug": "HomeManagerReactApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "homemanagerreactapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.anonymous.HomeManagerReactApp",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Home Manager to turn your spoken shopping list into text.",
        "NSMicrophoneUsageDescription": "Allow Home Manager to hear your shopping list."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.anonymous.HomeManagerReactApp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Home Manager to record a shopping list by voice."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Home Manager to hear your shopping list.",
          "speechRecognitionPermission": "Allow Home Manager to turn your spoken shopping list into text."
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
